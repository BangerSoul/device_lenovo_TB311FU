#
# Camera HAL Sepolicy Rules
#

allow hal_camera_default dmabuf_system_heap_device:chr_file { read write open ioctl };
allow hal_camera_default mtk_disp_device:chr_file { read write open ioctl };
allow hal_camera_default gpu_device:chr_file { read write open ioctl };
allow hal_camera_default sysfs:file { read open getattr };
