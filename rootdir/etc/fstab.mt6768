# Android fstab for MediaTek MT6768/MT8786 (Lenovo Tab with Clear Case (TB311FU) / poplar)
#
# <src>                                 <mnt_point>       <type>   <mnt_flags and options>                                  <fs_mgr_flags>

# Dynamic logical partitions (EROFS / EXT4)
system                                  /system           erofs    ro                                                       wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system                                  /system           ext4     ro                                                       wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext                              /system_ext       erofs    ro                                                       wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext                              /system_ext       ext4     ro                                                       wait,slotselect,avb=vbmeta_system,logical,first_stage_mount,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
vendor                                  /vendor           erofs    ro                                                       wait,slotselect,avb,logical,first_stage_mount
vendor                                  /vendor           ext4     ro                                                       wait,slotselect,avb,logical,first_stage_mount
product                                 /product          erofs    ro                                                       wait,slotselect,avb,logical,first_stage_mount
product                                 /product          ext4     ro                                                       wait,slotselect,avb,logical,first_stage_mount

# Metadata Partition
/dev/block/by-name/md_udc               /metadata         ext4     noatime,nosuid,nodev,discard                             wait,check,formattable,first_stage_mount

# Userdata Partition
/dev/block/by-name/userdata             /data             f2fs     noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065 latemount,wait,check,quota,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption

# Hardware Root of Trust / Calibration Partitions (Preserved & Read-Only Protected)
/dev/block/by-name/protect1             /mnt/vendor/protect_f ext4 ro,noatime,nosuid,nodev                                  wait,check,formattable
/dev/block/by-name/protect2             /mnt/vendor/protect_s ext4 ro,noatime,nosuid,nodev                                  wait,check,formattable
/dev/block/by-name/nvdata               /mnt/vendor/nvdata   ext4  noatime,nosuid,nodev                                     wait,check,formattable
/dev/block/by-name/nvcfg                /mnt/vendor/nvcfg    ext4  noatime,nosuid,nodev                                     wait,check,formattable
/dev/block/by-name/persist              /mnt/vendor/persist  ext4  ro,noatime,nosuid,nodev                                  wait,check,formattable
/dev/block/by-name/lenovocust           /lenovocust          ext4  noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable

# Core Boot / Firmware Partitions
/dev/block/by-name/boot                 /boot             emmc     defaults                                                 first_stage_mount,nofail,slotselect
/dev/block/by-name/vendor_boot          /vendor_boot      emmc     defaults                                                 first_stage_mount,nofail,slotselect
/dev/block/by-name/dtbo                 /dtbo             emmc     defaults                                                 defaults
/dev/block/by-name/vbmeta               /vbmeta           emmc     defaults                                                 defaults
/dev/block/by-name/vbmeta_system        /vbmeta_system    emmc     defaults                                                 first_stage_mount,nofail,slotselect,avb=vbmeta
/dev/block/by-name/vbmeta_vendor        /vbmeta_vendor    emmc     defaults                                                 first_stage_mount,nofail,slotselect

# Virtual memory / zram
/dev/block/zram0                        none              swap     defaults                                                 zramsize=75%
