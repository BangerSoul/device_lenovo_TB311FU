DEVICE_PATH := device/lenovo/TB311FU

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-2a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := cortex-a75

TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-2a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := cortex-a55

# Bootloader & Platform
TARGET_BOOTLOADER_BOARD_NAME := TB311FU
TARGET_NO_BOOTLOADER := true
BOARD_VENDOR := lenovo
TARGET_SOC := mt6769
TARGET_BOARD_PLATFORM := mt6768

# Kernel Architecture (GKI 2.0 Prebuilt)
TARGET_NO_KERNEL := false
BOARD_KERNEL_IMAGE_NAME := kernel
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel
TARGET_FORCE_PREBUILT_KERNEL := true
TARGET_KERNEL_CONFIG := tb311fu_defconfig
BOARD_USES_GENERIC_KERNEL_IMAGE := true
BOARD_USES_VENDOR_BOOT := true
BOARD_BOOT_HEADER_VERSION := 4
BOARD_MKBOOTIMG_ARGS += --header_version $(BOARD_BOOT_HEADER_VERSION)
BOARD_RAMDISK_USE_LZ4 := true
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_PREBUILT_DTBIMAGE_DIR := $(DEVICE_PATH)/prebuilt
BOARD_PREBUILT_DTBOIMAGE := $(DEVICE_PATH)/prebuilt/dtbo.img

# Partition Sizes & Recovery Configuration
BOARD_BOOTIMAGE_PARTITION_SIZE := 33554432
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 67108864
BOARD_DTBOIMG_PARTITION_SIZE := 8388608
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true

# Dynamic Super Partitions (11.00 GiB / 11,811,160,064 bytes)
BOARD_SUPER_PARTITION_SIZE := 11811160064
BOARD_SUPER_PARTITION_GROUPS := main
BOARD_MAIN_SIZE := 11809062912
BOARD_MAIN_PARTITION_LIST := \
    system \
    system_ext \
    vendor \
    product

# Partition Filesystem Types
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs

TARGET_USERIMAGES_USE_EXT4 := false
TARGET_USERIMAGES_USE_F2FS := true
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_PRODUCT := product
TARGET_COPY_OUT_SYSTEM_EXT := system_ext
TARGET_COPY_OUT_ODM := vendor/odm

# Virtual A/B Architecture
AB_OTA_UPDATER := true
AB_OTA_PARTITIONS += \
    boot \
    vendor_boot \
    dtbo \
    vbmeta \
    system \
    system_ext \
    vendor \
    product

# Android Verified Boot (AVB 2.0)
BOARD_AVB_ENABLE := true
BOARD_AVB_ALGORITHM := SHA256_RSA2048
BOARD_AVB_MAKE_VBMETA_IMAGE_ARGS += --flags 3
BOARD_AVB_VENDOR_BOOT_ADD_HASH_FOOTER_ARGS += --salt 5db37c8e2388c9788a77775fcf84c5acc26ee2bb5166a785cfa92909f7fb7bc5
BOARD_AVB_DTBO_ADD_HASH_FOOTER_ARGS += --salt 5db37c8e2388c9788a77775fcf84c5acc26ee2bb5166a785cfa92909f7fb7bc5
BOARD_AVB_BOOT_ADD_HASH_FOOTER_ARGS += --salt b71c04b0cf39fab8223b0a59ab8f546f1130da68b9cadc5401e16b81e365f79f
BOARD_MOVE_GSI_AVB_KEYS_TO_VENDOR_BOOT := true

# Recovery
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/recovery.fstab

# Linker Shims
TARGET_LD_SHIM_LIBS += \
    /vendor/lib64/hw/camera.mt6768.so|libshim_camera.so \
    /vendor/lib64/hw/sensors.mt6768.so|libshim_sensors.so \
    /vendor/lib64/hw/hwcomposer.mt6768.so|libshim_composer.so

# SELinux Policy
BOARD_VENDOR_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/vendor

# Build Broken Flags for Android 14 Compatibility
BUILD_BROKEN_CLANG_PROPERTY := true
BUILD_BROKEN_CLANG_ASFLAGS := true
BUILD_BROKEN_CLANG_CFLAGS := true
BUILD_BROKEN_DUP_RULES := true
BUILD_BROKEN_USES_SOONG_PYTHON2_MODULES := true
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
BUILD_BROKEN_PREBUILT_ELF_FILES := true
BUILD_BROKEN_OUTSIDE_INCLUDE_DIRS := true
BUILD_BROKEN_VINTF_PRODUCT_COPY_FILES := true
BUILD_BROKEN_MISSING_REQUIRED_MODULES := true

# Include Vendor BoardConfig if exists
-include vendor/lenovo/TB311FU/BoardConfigVendor.mk

# Inherit ArrowOS BoardConfig
-include vendor/arrow/config/BoardConfigArrow.mk
