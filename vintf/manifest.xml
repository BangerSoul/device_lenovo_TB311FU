<manifest version="5.0" type="device" target-level="8">
    <!-- Camera HAL -->
    <hal format="hidl">
        <name>android.hardware.camera.provider</name>
        <transport>hwbinder</transport>
        <version>2.6</version>
        <interface>
            <name>ICameraProvider</name>
            <instance>internal/0</instance>
        </interface>
    </hal>

    <!-- Display & Graphics Composer -->
    <hal format="hidl">
        <name>android.hardware.graphics.composer</name>
        <transport>hwbinder</transport>
        <version>2.4</version>
        <interface>
            <name>IComposer</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Graphics Allocator (Gralloc 4.0) -->
    <hal format="hidl">
        <name>android.hardware.graphics.allocator</name>
        <transport>hwbinder</transport>
        <version>4.0</version>
        <interface>
            <name>IAllocator</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Sensors Multi-HAL (AIDL) -->
    <hal format="aidl">
        <name>android.hardware.sensors</name>
        <version>2</version>
        <interface>
            <name>ISensors</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Power HAL (AIDL) -->
    <hal format="aidl">
        <name>android.hardware.power</name>
        <version>5</version>
        <interface>
            <name>IPower</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- Audio HAL -->
    <hal format="hidl">
        <name>android.hardware.audio</name>
        <transport>hwbinder</transport>
        <version>7.1</version>
        <interface>
            <name>IDevicesFactory</name>
            <instance>default</instance>
        </interface>
    </hal>

    <!-- DRM (Widevine L1) -->
    <hal format="hidl">
        <name>android.hardware.drm</name>
        <transport>hwbinder</transport>
        <version>1.4</version>
        <interface>
            <name>ICryptoFactory</name>
            <instance>default</instance>
            <instance>widevine</instance>
            <instance>clearkey</instance>
        </interface>
        <interface>
            <name>IDrmFactory</name>
            <instance>default</instance>
            <instance>widevine</instance>
            <instance>clearkey</instance>
        </interface>
    </hal>
</manifest>
