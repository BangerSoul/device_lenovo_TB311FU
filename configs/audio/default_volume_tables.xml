<?xml version="1.0" encoding="UTF-8"?>
<!--
    Lenovo Tab with Clear Case (TB311FU, poplar) - Default Volume Reference Tables
    TB311FU-specific: DEFAULT_DEVICE_CATEGORY_SPEAKER_VOLUME_CURVE upgraded to
    reach 0 dB at index 100. AW883xx amplifiers provide hardware protection.
    DAP volume-leveler tuned separately to not double-attenuate.
-->
<volumes>
    <!-- Full Scale reference - used for TTS and routing bypass -->
    <reference name="FULL_SCALE_VOLUME_CURVE">
        <point>0,0</point>
        <point>100,0</point>
    </reference>

    <reference name="SILENT_VOLUME_CURVE">
        <point>0,-9600</point>
        <point>100,-9600</point>
    </reference>

    <!-- System sounds (UI effects, clicks) - kept attenuated to not blast at max -->
    <reference name="DEFAULT_SYSTEM_VOLUME_CURVE">
        <point>1,-2400</point>
        <point>33,-1800</point>
        <point>66,-1200</point>
        <point>100,-600</point>
    </reference>

    <!-- HEADSET media - standard logarithmic, reaches 0 dB at max -->
    <reference name="DEFAULT_MEDIA_VOLUME_CURVE">
        <point>1,-5800</point>
        <point>20,-4000</point>
        <point>60,-1700</point>
        <point>100,0</point>
    </reference>

    <reference name="DEFAULT_DEVICE_CATEGORY_HEADSET_VOLUME_CURVE">
        <point>1,-4950</point>
        <point>33,-3350</point>
        <point>66,-1700</point>
        <point>100,0</point>
    </reference>

    <!-- TB311FU SPEAKER MEDIA - Optimized for quad-AW883xx array.
         Logarithmic taper engineered so the slider feels linear in perceived loudness.
         Reaches full 0 dB at 100 since AW883xx limits clip/thermal internally. -->
    <reference name="DEFAULT_DEVICE_CATEGORY_SPEAKER_VOLUME_CURVE">
        <point>1,-5800</point>
        <point>15,-3900</point>
        <point>30,-2600</point>
        <point>50,-1400</point>
        <point>75,-500</point>
        <point>100,0</point>
    </reference>

    <reference name="DEFAULT_DEVICE_CATEGORY_EARPIECE_VOLUME_CURVE">
        <point>1,-4950</point>
        <point>33,-3350</point>
        <point>66,-1700</point>
        <point>100,0</point>
    </reference>

    <reference name="DEFAULT_DEVICE_CATEGORY_EXT_MEDIA_VOLUME_CURVE">
        <point>1,-5800</point>
        <point>20,-4000</point>
        <point>60,-2100</point>
        <point>100,-1000</point>
    </reference>

    <reference name="DEFAULT_HEARING_AID_VOLUME_CURVE">
        <point>1,-12700</point>
        <point>20,-8000</point>
        <point>60,-4000</point>
        <point>100,0</point>
    </reference>

    <!-- Non-mutable curves (safe minimums for alarm, accessibility) -->
    <reference name="DEFAULT_NON_MUTABLE_VOLUME_CURVE">
        <point>0,-5800</point>
        <point>20,-4000</point>
        <point>60,-1700</point>
        <point>100,0</point>
    </reference>

    <reference name="DEFAULT_NON_MUTABLE_HEADSET_VOLUME_CURVE">
        <point>0,-4950</point>
        <point>33,-3350</point>
        <point>66,-1700</point>
        <point>100,0</point>
    </reference>

    <!-- Non-mutable speaker - alarm, accessibility need to reach full loudness -->
    <reference name="DEFAULT_NON_MUTABLE_SPEAKER_VOLUME_CURVE">
        <point>0,-5800</point>
        <point>15,-3900</point>
        <point>30,-2600</point>
        <point>50,-1400</point>
        <point>75,-500</point>
        <point>100,0</point>
    </reference>

    <reference name="DEFAULT_NON_MUTABLE_EARPIECE_VOLUME_CURVE">
        <point>0,-4950</point>
        <point>33,-3350</point>
        <point>66,-1700</point>
        <point>100,0</point>
    </reference>

    <reference name="DEFAULT_NON_MUTABLE_EXT_VOLUME_CURVE">
        <point>0,-5800</point>
        <point>20,-4000</point>
        <point>60,-2100</point>
        <point>100,-1000</point>
    </reference>

    <reference name="DEFAULT_NON_MUTABLE_HEARING_AID_VOLUME_CURVE">
        <point>0,-12700</point>
        <point>20,-8000</point>
        <point>60,-4000</point>
        <point>100,0</point>
    </reference>
</volumes>
