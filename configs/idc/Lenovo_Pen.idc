#
# Lenovo Tab Pen (AP500U / NVT Active Stylus Digitizer) Input Device Configuration
# Target: Lenovo Tab M11 (TB311FU)
#

# Basic Properties
touch.deviceType = touchScreen
touch.orientationAware = 1

# Touch Size
touch.size.calibration = area
touch.size.scale = 10
touch.size.bias = 0
touch.size.isSummed = 0

# Pressure Calibration: 4096 Pressure Levels (1 / 4096 = 0.000244140625)
touch.pressure.calibration = physical
touch.pressure.scale = 0.000244140625

# Palm Rejection & Orientation
touch.gestureMode = spots
device.internal = 1
keyboard.layout = qwerty
keyboard.characterMap = qwerty
keyboard.orientationAware = 1
keyboard.builtIn = 1
